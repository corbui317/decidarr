{
  "expo": {
    "name": "Decidarr",
    "slug": "decidarr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "decidarr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.decidarr.mobile"
    },
    "android": {
      "package": "com.decidarr.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
