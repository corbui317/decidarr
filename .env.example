# Decidarr Configuration
# =====================

# Optional - Change the exposed port (default: 3100)
PORT=3100

# Optional - Set log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Required in production - high-entropy secret for wrapping JWT/encryption keys
# Generate with: openssl rand -hex 32
# WARNING: Changing this after initial setup will invalidate all encrypted credentials.
# Recovery: If changed, you must re-enter all integration credentials (Plex, TMDB, Tautulli, Overseerr) in Settings.
DECIDARR_SECRET=

# Recommended for public first-run setup - one-time gate before setupComplete
# Generate with: openssl rand -hex 16
DECIDARR_SETUP_SECRET=

# Network Safety: Private/LAN URL Access (default: false)
# Private addresses (192.168.x.x, 10.x.x.x, 172.16-31.x.x) are blocked by default
# for security. Set to 'true' only if your Plex, Tautulli, or Overseerr are on your
# local network (home/office LAN). Public cloud deployments should keep this false.
DECIDARR_ALLOW_PRIVATE_URLS=false

# Recommended - the public origin users open Decidarr at, e.g. https://decidarr.example.com
# Plex sign-in only redirects back to this origin; leave empty to skip the redirect.
APP_URL=

# Set to 'true' only behind a reverse proxy that sets X-Forwarded-For, so sign-in
# rate limits are counted per client. Never enable it without such a proxy: clients
# could then pick their own rate-limit key.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Cookie security
# -----------------------------------------------------------------------------
# Local HTTP development:
#   NODE_ENV=development
#   SECURE_COOKIES=false
#
# Production HTTPS behind a reverse proxy:
#   NODE_ENV=production
#   SECURE_COOKIES=true
#
# SECURE_COOKIES defaults to true when NODE_ENV=production.
# Disabling secure cookies on a public HTTPS origin is unsupported.
SECURE_COOKIES=false

# E2E test only - required header secret for POST /api/test/reset
E2E_TEST_RESET_SECRET=

# Note: Plex token, TMDB API key, Tautulli settings, and sync settings are all
# configured through the Settings UI in the application.
